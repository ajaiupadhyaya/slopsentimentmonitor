# Copy to .env. Every value below has a working default or degrades cleanly —
# the pipeline ingests real data with none of the optional keys set.

# --- Infrastructure (matches docker-compose.yml) ---
PULSEAI_DATABASE_URL=postgresql+asyncpg://pulseai:pulseai@localhost:5433/pulseai
PULSEAI_REDIS_URL=redis://localhost:6380/0

# --- Collectors ---
# Sent on every outbound request. Reddit and some APIs reject generic agents.
PULSEAI_USER_AGENT=pulseai/0.1 (+https://github.com/ajaiupadhyaya/slopsentimentmonitor)

# GitHub: optional. Without it you get 60 req/hr; with it, 5,000.
# Populate from your existing login:  gh auth token
# PULSEAI_GITHUB_TOKEN=

# Reddit: optional. The collector skips cleanly when unset.
# Create a free "script" app at https://www.reddit.com/prefs/apps
# PULSEAI_REDDIT_CLIENT_ID=
# PULSEAI_REDDIT_CLIENT_SECRET=

# --- Analysis ---
# local     = HuggingFace transformers on-device (needs: uv sync --extra ml)
# heuristic = pure Python, no downloads, lower accuracy
# auto      = local if importable, else heuristic
PULSEAI_ANALYZER=auto
